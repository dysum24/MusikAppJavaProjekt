<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Root-Layout der gesamten Anwendung -->
<BorderPane stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.javaprojektmusikapp.controller.MainController">

   <!-- Zentrale Content-Fläche (Views werden dynamisch geladen) -->
   <center>
      <AnchorPane fx:id="contentPane"
                  prefHeight="400.0"
                  prefWidth="600.0">
      </AnchorPane>
   </center>

   <!-- Obere Suchleiste (nur auf Home sichtbar) -->
   <top>
      <HBox fx:id="topSearchBar"
            prefHeight="60.0"
            spacing="10.0"
            BorderPane.alignment="CENTER">

         <!-- Abstand zum Rand -->
         <BorderPane.margin>
            <Insets bottom="10"
                    left="20"
                    right="20"
                    top="14"/>
         </BorderPane.margin>

         <children>
            <!-- Spacer links -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Suchfeld -->
            <TextField fx:id="topSearchField"
                       promptText="Was möchtest du spielen?"
                       styleClass="search-field"/>

            <!-- Such-Button -->
            <Button text="Suchen"
                    onAction="#onTopSearch"
                    styleClass="search-btn"/>

            <!-- Spacer rechts -->
            <Region HBox.hgrow="ALWAYS"/>
         </children>
      </HBox>
   </top>

   <!-- Linke Sidebar mit Navigation und Playlists -->
   <left>
      <fx:include fx:id="sidebar"
                  source="sidebar.fxml"/>
   </left>

   <!-- Untere Playerbar -->
   <bottom>
      <fx:include fx:id="playerbar"
                  source="playerbar.fxml"/>
   </bottom>

</BorderPane>
