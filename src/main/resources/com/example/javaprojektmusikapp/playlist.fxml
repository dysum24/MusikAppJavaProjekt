<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Root-Container der Playlist-Seite -->
<VBox spacing="16"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.javaprojektmusikapp.controller.PlaylistController"
      styleClass="content-root">

    <!-- Überschrift mit dem Namen der Playlist -->
    <Label fx:id="playlistTitle"
           text="Playlist"
           styleClass="content-title"/>

    <!-- Liste mit allen Songs der Playlist -->
    <ListView fx:id="songList"
              VBox.vgrow="ALWAYS"
              styleClass="song-list"/>

</VBox>
