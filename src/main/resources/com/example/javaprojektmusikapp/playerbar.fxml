<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Untere Player-Leiste der Anwendung -->
<HBox prefHeight="90.0"
      prefWidth="200.0"
      spacing="12.0"
      styleClass="playerbar"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.javaprojektmusikapp.controller.PlayerController">

    <!-- Innenabstand der Playerbar -->
    <padding>
        <Insets bottom="12.0"
                left="12.0"
                right="12.0"
                top="12.0"/>
    </padding>

    <children>
        <!-- Coverbild des aktuellen Songs -->
        <ImageView fx:id="coverImage"
                   fitHeight="56.0"
                   fitWidth="56.0"
                   pickOnBounds="true"
                   preserveRatio="true"/>

        <!-- Titel- und Künstleranzeige -->
        <VBox prefHeight="200.0"
              prefWidth="100.0"
              spacing="2.0">
            <children>
                <Label fx:id="titleLabel"
                       styleClass="player-title"
                       text="Songtitel"/>
                <Label fx:id="artistLabel"
                       styleClass="player-artist"
                       text="Künstler"/>
            </children>
        </VBox>

        <!-- Spacer zwischen Songinfo und Player-Steuerung -->
        <Region prefHeight="200.0"
                prefWidth="200.0"
                HBox.hgrow="ALWAYS"/>

        <!-- Play / Pause Button -->
        <Button fx:id="playPauseBtn"
                mnemonicParsing="false"
                onAction="#onPlayPause"
                styleClass="play-btn"
                text="▶"/>

        <!-- Fortschritts-Slider -->
        <Slider fx:id="progressSlider"
                blockIncrement="1.0"
                focusTraversable="false"
                max="30.0"
                prefHeight="34.0"
                prefWidth="150.0"
                styleClass="progress-slider"/>

        <!-- Zeit-Anzeige -->
        <HBox spacing="5">
            <Label fx:id="currentTimeLabel"
                   text="0:00"
                   textFill="WHITE"/>
            <Label text="/"/>
            <Label fx:id="totalTimeLabel"
                   text="0:00"
                   textFill="WHITE"/>
        </HBox>

        <!-- Spacer zwischen Zeit und Lautstärke -->
        <Region prefHeight="200.0"
                prefWidth="200.0"
                HBox.hgrow="ALWAYS"/>

        <!-- Lautstärke-Slider -->
        <Slider fx:id="volumeSlider"
                focusTraversable="false"
                orientation="VERTICAL"
                prefHeight="60.0"
                styleClass="volume-slider"
                value="70.0"/>
    </children>
</HBox>
