<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import com.example.javaprojektmusikapp.model.Song?>

<!-- Root-Container der Favorites-Seite -->
<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.javaprojektmusikapp.controller.FavoritesController"
      spacing="18"
      styleClass="page-root">

    <!-- Innenabstand der Seite -->
    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <!-- Überschrift der Seite -->
    <Label text="Favorites"
           styleClass="page-title"/>

    <!-- Liste mit allen favorisierten Songs -->
    <ListView fx:id="favoritesList"
              VBox.vgrow="ALWAYS"
              styleClass="song-list"/>

</VBox>
