<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<!-- Root-Container der Search-Seite -->
<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.javaprojektmusikapp.controller.SearchController">

    <!-- Inhalt der Search-Seite -->
    <VBox spacing="18"
          layoutX="32"
          layoutY="32"
          prefWidth="760"
          maxWidth="Infinity"
          styleClass="page-root">

        <!-- Überschrift der Seite -->
        <Label text="Search"
               styleClass="page-title"/>

        <!-- Eingabefeld für die Suchanfrage -->
        <TextField fx:id="searchField"
                   promptText="Suche nach Songs, Künstlern oder Alben"
                   styleClass="search-field"/>

        <!-- Button zum Starten der Suche -->
        <Button text="Suchen"
                onAction="#onSearch"
                styleClass="search-btn"/>

        <!-- Ergebnisliste der Suche -->
        <ListView fx:id="resultsList"
                  visible="false"
                  managed="false"
                  focusTraversable="false"/>

    </VBox>

</AnchorPane>
